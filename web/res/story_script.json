  "scenes": [
    {
      "id": "day-01",
      "day": 1,
      "title": "Hospitality",
      "sources": [
        "text/broadcasts/week-1.txt",
        "text/street.txt",
        "text/visitors/ayling.txt"
      ],
      "beats": [
        {
          "kind": "action",
          "text": "The house opens on a street still full of ordinary traffic, tea, shopping, drains, and people lending one another small help."
        },
        {
          "kind": "dialogue",
          "text": "Iris names Ron casually; Ayling offers the shop and the wall-knock compact begins.",
          "speaker": "iris"
        }
      ],
      "branches": [
        {
          "id": "day-01-care",
          "prompt": "How do you meet the first small kindness?",
          "options": [
            {
              "id": "accept",
              "label": "Accept tea or help and keep the wall-knock promise.",
              "next": "day-02"
            },
            {
              "id": "refuse",
              "label": "Refuse politely and keep the distance.",
              "next": "day-02"
            }
          ]
        }
      ]
    },
    {
      "id": "day-02",
      "day": 2,
      "title": "Family evidence",
      "sources": [
        "text/visitors/sibling.txt",
        "text/visitors/nurse.txt"
      ],
      "beats": [
        {
          "kind": "action",
          "text": "Denise brings pears and three true domestic facts before an over-precise memory. Nurse and Ken establish reliable outside routines."
        },
        {
          "kind": "dialogue",
          "text": "The pears are left on the step; the family argument is warm, ordinary, and specific.",
          "speaker": "denise"
        }
